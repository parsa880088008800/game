  if(!DB||!UID||canWrite===false){m.textContent=!DB||!UID?"برای ثبت‌نام باید با حساب کاربری وارد شده باشی و به‌عنوان «مشارکت‌کننده» به این بازی دسترسی داشته باشی.":"حساب تو فقط اجازهٔ دیدن دارد و نمی‌تواند ثبت‌نام کند.";inp.disabled=b.disabled=true;u.hidden=true;return;}
  const reg=PL[UID];inp.disabled=b.disabled=false;
  if(reg&&document.activeElement!==inp)inp.value=reg;
  m.textContent=reg?"ثبت‌نام شده‌ای با نام «"+reg+"». می‌توانی نامت را عوض کنی.":"نام نمایشی‌ات را بنویس و ثبت‌نام کن تا رکوردت در رتبه‌بندی دیده شود.";
  b.textContent=reg?"تغییر نام":"ثبت‌نام در رتبه‌بندی";u.hidden=!reg;
}
$("regBtn").addEventListener("click",async()=>{
  const n=$("nick").value.trim().slice(0,16);
  if(n.length<2){$("regMsg").textContent="نام باید حداقل ۲ حرف باشد.";return;}
  try{
    await DB.collection("players").doc(UID).set({n,ts:Date.now()});
    showToast("ثبت‌نام انجام شد.");
    if(save.wk===weekNo()&&save.wb>0)pushScore(save.wb);
  }catch(e){$("regMsg").textContent="ثبت‌نام انجام نشد. دسترسی‌ات را بررسی کن.";}
});
$("unregBtn").addEventListener("click",async()=>{try{await DB.collection("players").doc(UID).delete();$("nick").value="";}catch(e){}});
$("lbToReg").addEventListener("click",()=>showPage("Reg"));
let PW=null,pwReady=false,admOK=false;
const rndHex=()=>Array.from(crypto.getRandomValues(new Uint8Array(16))).map(b=>b.toString(16).padStart(2,"0")).join("");
async function hashPw(pw,salt){
  const enc=new TextEncoder(),k=await crypto.subtle.importKey("raw",enc.encode(pw),"PBKDF2",false,["deriveBits"]);
  const bits=await crypto.subtle.deriveBits({name:"PBKDF2",salt:enc.encode(salt),iterations:100000,hash:"SHA-256"},k,256);
  return Array.from(new Uint8Array(bits)).map(b=>b.toString(16).padStart(2,"0")).join("");
}
function renderAdmin(){
  if(!isAdmin)return;
  const lock=$("admLock"),panel=$("admPanel"),msg=$("admMsg");
  if(!pwReady){msg.textContent="در حال بارگذاری...";lock.hidden=true;panel.hidden=true;return;}
  if(admOK){
    lock.hidden=true;panel.hidden=false;msg.textContent="بخش مدیران";
    $("admState").textContent="وضعیت رتبه‌بندی: "+(lbOn?"روشن":"خاموش");
    $("admCount").textContent="تعداد ثبت‌نام‌شده‌ها: "+Object.keys(PL).length;
    $("admToggle").textContent=lbOn?"خاموش کردن رتبه‌بندی":"روشن کردن رتبه‌بندی";
  }else{
    panel.hidden=true;lock.hidden=false;
    if(PW){msg.textContent="برای ورود به بخش مدیران رمز را وارد کن.";$("admGo").textContent="ورود";}
    else{msg.textContent="هنوز رمزی تعیین نشده. یک رمز دست‌کم ۶ حرفی برای بخش مدیران بنویس.";$("admGo").textContent="تعیین رمز";}
  }
}
$("admGo").addEventListener("click",async()=>{
  const v=$("admPw").value,b=$("admGo");
  if(!isAdmin||!DB)return;
  if(v.length<6){$("admMsg").textContent="رمز باید دست‌کم ۶ حرف باشد.";return;}
  b.disabled=true;
  try{
    if(PW){
      if(await hashPw(v,PW.salt)===PW.hash){admOK=true;$("admPw").value="";}
      else{$("admMsg").textContent="رمز اشتباه است.";await new Promise(r=>setTimeout(r,2000));}
    }else{
      const salt=rndHex();await DB.doc("adm/pw").set({salt,hash:await hashPw(v,salt)});admOK=true;$("admPw").value="";
    }
  }catch(e){$("admMsg").textContent="انجام نشد: دسترسی مدیر لازم است.";}
  b.disabled=false;renderAdmin();
});
$("admChange").addEventListener("click",async()=>{
  const v=$("admNew").value;
  if(!isAdmin||!DB||!admOK)return;
  if(v.length<6){$("admState").textContent="رمز جدید باید دست‌کم ۶ حرف باشد.";return;}
  try{const salt=rndHex();await DB.doc("adm/pw").set({salt,hash:await hashPw(v,salt)});$("admNew").value="";$("admState").textContent="رمز عوض شد.";}
  catch(e){$("admState").textContent="تغییر رمز انجام نشد.";}
});
$("admLockBtn").addEventListener("click",()=>{admOK=false;renderAdmin();});
$("admToggle").addEventListener("click",async()=>{
  if(!isAdmin||!DB||!admOK)return;
  const b=$("admToggle");b.disabled=true;
  try{await DB.doc("cfg/lb").set({on:!lbOn});}catch(e){$("admState").textContent="تغییر انجام نشد: دسترسی مدیر لازم است.";}
  b.disabled=false;
});
setInterval(()=>{if(DB&&weekNo()!==curWk){subscribeWeek();checkPrizes();}$("lbTime").textContent="تا ریست رتبه‌بندی (هر شنبه ساعت ۰۰:۰۰ UTC): "+fmtLeft();},60000);
initOnline();
let last=performance.now();
function frame(now){
  const dt=Math.min(.05,(now-last)/1000);last=now;clock+=dt;
  if(state==="play")update(dt);else dist+=10*dt;
  ctx.save();
  if(shake>0&&!RM)ctx.translate((Math.random()-.5)*10*shake,(Math.random()-.5)*8*shake);
  scene(dt);
  obs.slice().sort((a,b)=>b.z-a.z).forEach(drawObs);
  const pxs=W/2+px*RH*P0;
  if(state!=="ready"){
    ctx.save();ctx.translate(pxs,PY);ctx.rotate(vx*.03);ctx.translate(-pxs,-PY);
    car(pxs,PY,.5*RH*P0,cur().col,false,clock,{br:keys.d&&state==="play",kind:cur().kind,ph:ab.act>0&&cur().kind==="ghost",bo:ab.act>0&&(cur().kind==="bolt"||cur().kind==="magic")});ctx.restore();
  }
  if(state!=="ready"){
    polX+=(pxs-polX)*Math.min(1,dt*3)||0;if(!polX)polX=pxs;
    const by=H+20+gap*3.2;
    if(by-100<H)car(polX,by,130,"#15181f",true,clock);
    if(gap<45&&!RM){const a=(45-gap)/45*.16,on=Math.floor(clock*2)%2;
      const gr=ctx.createLinearGradient(0,H,0,H-260);gr.addColorStop(0,(on?"rgba(255,30,30,":"rgba(40,110,255,")+a+")");gr.addColorStop(1,"rgba(0,0,0,0)");
      ctx.fillStyle=gr;ctx.fillRect(0,H-260,W,260);}
  }
  if(hitFlash>0&&!RM){ctx.fillStyle="rgba(229,56,59,"+hitFlash*.3+")";ctx.fillRect(0,0,W,H);}
  ctx.restore();
  const ak=cur().kind;if(ACT.includes(ak)){const pa=$("pa");pa.textContent=ab.act>0?"فعال":ab.cd>0?Math.ceil(ab.cd)+" ثانیه":"توانایی";pa.style.opacity=ab.cd>0&&ab.act<=0?.55:1;}
  $("sc").textContent=Math.floor(dist)+" م";$("sp").textContent=Math.round(speed*3)+" km/h";
  const gi=$("gp");gi.style.width=Math.max(0,gap)+"%";gi.style.background=gap>50?"#3ddc84":gap>25?"#f2b134":"#e5383b";
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
$("go").addEventListener("click",reset);
addEventListener("keydown",e=>{if(e.target.tagName==="INPUT")return;
  if(e.key==="ArrowLeft"||e.key==="a")keys.l=1;
  if(e.key==="ArrowRight"||e.key==="d")keys.r=1;
  if(e.key==="ArrowUp"||e.key==="w"){keys.u=1;e.preventDefault();}
  if(e.key==="ArrowDown"||e.key==="s"){keys.d=1;e.preventDefault();}
  if((e.key==="Enter"||e.key===" ")&&state!=="play"){const bt=e.target.closest&&e.target.closest("button");if(!$("pgGame").hidden&&(!bt||bt.id==="go")){e.preventDefault();reset();}}
  else if(state==="play"&&(e.key===" "||e.key==="e")){e.preventDefault();useAbility();}
});
addEventListener("keyup",e=>{if(e.target.tagName==="INPUT")return;
  if(e.key==="ArrowLeft"||e.key==="a")keys.l=0;
  if(e.key==="ArrowRight"||e.key==="d")keys.r=0;
  if(e.key==="ArrowUp"||e.key==="w")keys.u=0;
  if(e.key==="ArrowDown"||e.key==="s")keys.d=0;
});
function ptr(e,down){
  const r=cv.getBoundingClientRect(),left=(e.clientX-r.left)<r.width/2;
  keys.l=0;keys.r=0;if(down){if(left)keys.l=1;else keys.r=1;}
}
cv.addEventListener("pointerdown",e=>ptr(e,true));
cv.addEventListener("pointermove",e=>{if(e.buttons)ptr(e,true);});
addEventListener("pointerup",e=>{if(!(e.target.closest&&e.target.closest(".pedals"))){keys.l=0;keys.r=0;}});
addEventListener("pointercancel",()=>{keys.l=0;keys.r=0;});
[["pg","u"],["pb","d"]].forEach(([id,k])=>{const el=$(id);
  el.addEventListener("pointerdown",e=>{e.preventDefault();keys[k]=1;});
  ["pointerup","pointerleave","pointercancel"].forEach(ev=>el.addEventListener(ev,()=>{keys[k]=0;}));});
$("pa").addEventListener("pointerdown",e=>{e.preventDefault();useAbility();});
</script>
