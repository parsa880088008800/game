<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>فرار از پلیس</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#EEF1F5;--ink:#10192b;--muted:#566275;--gold:#F2B134;--red:#e5383b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#080d18;--ink:#e8edf6;--muted:#8d9ab0}}
:root[data-theme="dark"]{--bg:#080d18;--ink:#e8edf6;--muted:#8d9ab0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Vazirmatn,Tahoma,sans-serif;display:flex;justify-content:center;min-height:100vh}
main{width:100%;max-width:480px;padding:14px 12px 24px}
h1{margin:4px 0 10px;font-size:1.6rem;font-weight:900}
.hud{display:flex;gap:8px;align-items:stretch;margin-bottom:8px}
.box{padding:6px 10px;border-radius:10px;background:rgba(127,140,160,.15);min-width:78px}
.box small{display:block;font-size:.7rem;color:var(--muted)}
.box b{font-size:1.1rem}
.gapbox{flex:1}
.bar{height:10px;border-radius:5px;background:rgba(127,140,160,.3);margin-top:6px;overflow:hidden}
.bar i{display:block;height:100%;width:55%;background:#3ddc84;transition:width .1s,background .2s}
.wrap{position:relative;border-radius:14px;overflow:hidden;border:3px solid #1b2540;touch-action:none;user-select:none}
canvas{display:block;width:100%;height:auto;aspect-ratio:3/4}
.ov{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:rgba(6,10,22,.78);color:#fff;text-align:center;padding:20px}
.ov.hide{display:none}
.ov h2{margin:0;font-size:1.8rem;font-weight:900}
.ov p{margin:0;color:#c5cfe2;line-height:1.8}
.ov button{margin-top:6px;padding:12px 34px;border:0;border-radius:12px;background:var(--gold);color:#12203a;font:inherit;font-weight:900;font-size:1.1rem;cursor:pointer}
.ov button:focus-visible{outline:3px solid #fff;outline-offset:3px}
.pedals{display:flex;gap:10px;margin-top:10px}
.pedals button{flex:1;padding:16px 0;border:0;border-radius:14px;font:inherit;font-weight:900;font-size:1.1rem;color:#fff;touch-action:none;user-select:none;cursor:pointer}
#pb{background:#c1121f}
#pg{background:#1b9e5a}
.pedals button:active{filter:brightness(1.25);transform:translateY(2px)}
.pedals button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.ov{overflow:auto;justify-content:flex-start;gap:0}
.ovin{margin:auto;display:flex;flex-direction:column;align-items:center;gap:8px;width:100%}
.ov .cd{font-size:.85rem}
#pa{background:#6a3df0}
.tabs{display:flex;gap:8px;margin-bottom:10px}
.tabs button{flex:1;padding:10px;border:2px solid var(--muted);border-radius:12px;background:transparent;color:var(--ink);font:inherit;font-weight:700;cursor:pointer}
.tabs button.on{background:var(--gold);border-color:var(--gold);color:#12203a}
.tabs button:disabled{opacity:.45;cursor:not-allowed}
.tabs button:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.pg[hidden]{display:none}
.garage{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.gc{display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 6px;border:2px solid rgba(127,140,160,.45);border-radius:14px;background:rgba(127,140,160,.12);color:var(--ink);font:inherit;font-size:.9rem;cursor:pointer;text-align:center}
.gc canvas{width:100%;max-width:150px;height:auto;background:#141b33;border-radius:10px}
.gc .nm{font-weight:900;font-size:1rem}
.gc small{color:var(--muted)}
.gc .d{font-size:.74rem;line-height:1.5}
.gc .g{color:#1f9d57}
.gc .x{color:#d63a3a}
.gc.sel{border-color:var(--gold);background:rgba(242,177,52,.16)}
.gc.lock{opacity:.55}
.gc:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.ptsline{margin:0 0 10px;color:var(--muted)}
.ov .alt{background:transparent;color:#fff;border:2px solid #fff;margin-top:0}
.prize{display:flex;gap:12px;align-items:center;padding:10px;border:2px solid #c77dff;border-radius:14px;background:rgba(199,125,255,.1);margin-bottom:10px}
.prize canvas{width:110px;height:auto;background:#141b33;border-radius:10px;flex:none}
.prize p{margin:4px 0 0;font-size:.85rem;color:var(--muted);line-height:1.6}
.lb{list-style:none;margin:0 0 10px;padding:0;display:flex;flex-direction:column;gap:6px}
.lb li{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:12px;background:rgba(127,140,160,.12)}
.lb li.me{background:rgba(242,177,52,.22);outline:2px solid var(--gold)}
.lb .rk{width:2rem;text-align:center;font-weight:900}
.lb .nm{flex:1}
.lb .sc{font-weight:700}
.toast{margin:0 0 10px;padding:10px 12px;border-radius:12px;background:var(--gold);color:#12203a;font-weight:700}
.toast[hidden]{display:none}
html,body{height:100%;overflow:hidden}
body{display:block;min-height:0}
main{height:100%;max-width:480px;margin:0 auto;padding:6px 10px;display:flex;flex-direction:column;overflow:hidden}
h1{font-size:1.1rem;margin:0 0 6px}
.tabs{flex:none;gap:4px;margin-bottom:6px}
.tabs button{padding:7px 2px;font-size:.78rem;border-width:1.5px;border-radius:10px;white-space:nowrap}
.toast{flex:none}
.pg{flex:1;min-height:0;overflow:hidden}
.pg:not([hidden]){display:flex;flex-direction:column}
.hud{flex:none;margin-bottom:6px}
.box{min-width:0;padding:4px 8px}
.box b{font-size:1rem}
.wrap{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;border:0;border-radius:0;overflow:visible}
.stage{position:relative;border:3px solid #1b2540;border-radius:14px;overflow:hidden;touch-action:none;user-select:none;width:300px;height:400px}
.stage canvas{width:100%;height:100%;aspect-ratio:auto}
.pedals{flex:none;margin-top:6px}
.pedals button{padding:12px 0}
.garage{display:flex;flex-direction:column;align-items:center;gap:8px}
.gcard{display:flex;flex-direction:column;align-items:center;gap:3px;width:100%;padding:8px;border:2px solid rgba(127,140,160,.45);border-radius:14px;background:rgba(127,140,160,.12);text-align:center}
.gcard.sel{border-color:var(--gold);background:rgba(242,177,52,.16)}
.gcard canvas{width:min(100%,240px);height:auto;background:#141b33;border-radius:10px}
.gcard .nm{font-size:1.05rem;font-weight:900}
.gcard .d{font-size:.78rem;line-height:1.5}
.gcard .g{color:#1f9d57}
.gcard .x{color:#d63a3a}
.gnav{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%}
.gnav button{padding:8px 18px;border:2px solid var(--muted);border-radius:10px;background:transparent;color:var(--ink);font:inherit;font-weight:700;cursor:pointer}
.big{width:100%;margin-top:8px;padding:12px;border:0;border-radius:12px;background:var(--gold);color:#12203a;font:inherit;font-weight:900;cursor:pointer}
.big:disabled{opacity:.5;cursor:not-allowed}
.big.alt2{background:transparent;color:var(--ink);border:2px solid var(--muted)}
.big:focus-visible,.gnav button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
input{width:100%;padding:10px;border-radius:10px;border:2px solid var(--muted);background:transparent;color:var(--ink);font:inherit}
label{display:block;margin:6px 0;font-weight:700}
.prize canvas{width:90px}
.lb{gap:4px;margin-bottom:6px}
.lb li{padding:6px 10px}
#pgGarage,#pgLb,#pgAdmin,#pgReg{overflow-y:auto}
#pgGarage>*,#pgLb>*,#pgAdmin>*,#pgReg>*{flex:none}
#pgGarage .ptsline{position:sticky;top:0;z-index:1;margin:0 0 8px;padding:4px 0;background:var(--bg)}
.garage{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;align-items:stretch}
.hint{margin:10px 0 0;color:var(--muted);font-size:.85rem;text-align:center}
</style>
</head>
<body>
<main>
  <h1>فرار از پلیس</h1>
  <nav class="tabs"><button id="tgm" class="on">بازی</button><button id="tgg">گاراژ</button><button id="tgl">رتبه‌بندی</button><button id="tgr">ثبت‌نام</button><button id="tga" hidden>مدیر</button></nav>
  <div class="toast" id="toast" hidden></div>
  <section class="pg" id="pgGame">
  <div class="hud">
    <div class="box"><small>مسافت</small><b id="sc">0 م</b></div>
    <div class="box"><small>سرعت</small><b id="sp">0</b></div>
    <div class="box"><small>رکورد</small><b id="bs">0</b></div>
    <div class="box gapbox"><small>فاصله تا پلیس</small><div class="bar"><i id="gp"></i></div></div>
  </div>
  <div class="wrap" id="wrapG"><div class="stage" id="stage">
    <canvas id="c" width="480" height="640"></canvas>
    <div class="ov" id="ov"><div class="ovin">
      <h2 id="ot">آماده‌ای؟</h2>
      <p id="om">از موانع رد شو؛ هر برخورد پلیس را نزدیک می‌کند.<br>فرمان: چپ و راست، گاز و ترمز: بالا و پایین، توانایی: Space</p>
      <p>امتیاز شما: <b id="pts">0</b></p>
      <p class="cd" id="curcar"></p>
      <button id="go">شروع</button>
      <button id="gg" class="alt">گاراژ</button>
      <button id="gl" class="alt">رتبه‌بندی</button>
    </div></div>
  </div></div>
  <div class="pedals"><button id="pb" aria-label="ترمز">ترمز</button><button id="pa" aria-label="توانایی" style="display:none">توانایی</button><button id="pg" aria-label="گاز">گاز</button></div>
  </section>
  <section class="pg" id="pgGarage" hidden>
    <p class="ptsline">امتیاز شما: <b id="pts2">0</b>. برای انتخاب یا خرید روی ماشین بزن.</p>
    <div class="garage" id="garage"></div>
  </section>
  <section class="pg" id="pgLb" hidden>
    <div class="prize"><canvas id="prizeCv" width="150" height="104"></canvas><div><b>جایزهٔ برندهٔ هفته: ققنوس جادویی</b><p>هر هفته کسی که بیشترین رکورد را داشته باشد، این ماشین را برای همیشه می‌گیرد. هیچ ضعفی ندارد و توانایی‌های زیادی دارد.</p></div></div>
    <p class="ptsline" id="lbTime"></p>
    <p class="ptsline" id="lbMsg"></p>
    <button id="lbToReg" class="big" hidden>رفتن به ثبت‌نام</button>
    <ol class="lb" id="lbList"></ol>
    <p class="ptsline" id="lbMine"></p>
    <p class="ptsline" id="lbLast"></p>
  </section>
  <section class="pg" id="pgReg" hidden>
    <p class="ptsline" id="regMsg"></p>
    <label for="nick">نام نمایشی در رتبه‌بندی</label>
    <input id="nick" maxlength="16" autocomplete="off" placeholder="مثلاً: علی سرعت">
    <button id="regBtn" class="big">ثبت‌نام در رتبه‌بندی</button>
    <button id="unregBtn" class="big alt2" hidden>لغو ثبت‌نام</button>
  </section>
  <section class="pg" id="pgAdmin" hidden>
    <p class="ptsline" id="admMsg"></p>
    <div id="admLock" hidden>
      <label for="admPw">رمز مدیر</label>
      <input id="admPw" type="password" autocomplete="off">
      <button id="admGo" class="big">ورود</button>
    </div>
    <div id="admPanel" hidden>
      <p id="admState"></p>
      <p class="ptsline" id="admCount"></p>
      <button id="admToggle" class="big">تغییر وضعیت رتبه‌بندی</button>
      <label for="admNew">رمز جدید</label>
      <input id="admNew" type="password" autocomplete="new-password">
      <button id="admChange" class="big alt2">تغییر رمز</button>
      <button id="admLockBtn" class="big alt2">قفل کردن بخش مدیر</button>
    </div>
  </section>
</main>
<script>
const cv=document.getElementById("c");let ctx=cv.getContext("2d");
const W=480,H=640,HOR=250,RH=230,NEAR=3,P0=0.754,Z0=NEAR*(1/P0-1),PY=HOR+(H-HOR)*P0;
const $=id=>document.getElementById(id);
const RM=matchMedia("(prefers-reduced-motion:reduce)").matches;
const COLS=["#3b7dd8","#6b7a8a","#3aa66b","#8a5ad8"];
let state="ready",px=0,vx=0,speed=36,dist=0,t=0,gap=55,obs=[],nextSp=0,shake=0,hitFlash=0,polX=0,clock=0;
const keys={l:0,r:0,u:0,d:0};
const CARS=[
 {id:0,name:"پرایم",col:"#f2b134",kind:"std",cost:0,good:["ماشین اولیه و متعادل"],bad:[]},
 {id:1,name:"تانک",col:"#4f8a5b",kind:"tank",cost:600,armor:.5,steer:.7,acc:.8,good:["زره: هر برخورد نصف آسیب می‌زند"],bad:["فرمان سنگین","شتاب کم"]},
 {id:4,name:"چابک",col:"#2ab7ca",kind:"drift",cost:900,steer:1.5,armor:1.5,good:["فرمان خیلی تیز"],bad:["بدنه ضعیف: برخورد ۵۰٪ بدتر"]},
 {id:5,name:"موتور",col:"#ff8a00",kind:"bike",cost:1200,w:.24,acc:1.3,armor:2,good:["باریک است و راحت از بین موانع رد می‌شود","شتاب بیشتر"],bad:["هر برخورد دو برابر آسیب می‌زند"]},
 {id:2,name:"شبح",col:"#7b5cff",kind:"ghost",cost:1500,armor:1.3,good:["توانایی: ۲٫۵ ثانیه از موانع رد می‌شود (۱۴ ثانیه صبر)"],bad:["بدنه شکننده: برخورد ۳۰٪ بدتر"]},
 {id:6,name:"کامیون",col:"#9a6b3b",kind:"truck",cost:2000,w:.62,armor:.6,acc:.6,top:-6,steer:.8,good:["بدنه محکم: برخورد ۴۰٪ کم‌تر آسیب می‌زند"],bad:["بزرگ است و راحت‌تر به موانع می‌خورد","شتاب و سرعت کم","فرمان سنگین"]},
 {id:3,name:"برق",col:"#e5383b",kind:"bolt",cost:3000,brk:.6,good:["توانایی: نیترو، ۳ ثانیه سرعت خیلی زیاد (۱۲ ثانیه صبر)"],bad:["ترمز ضعیف"]},
 {id:7,name:"سوپر",col:"#f1f1f1",kind:"super",cost:5000,top:10,acc:1.4,steer:.85,brk:.6,armor:1.5,good:["بالاترین سرعت","شتاب عالی"],bad:["ترمز ضعیف","فرمان کمی سنگین","بدنه ضعیف: برخورد ۵۰٪ بدتر"]},
 {id:8,name:"ققنوس جادویی",col:"#ffd34d",kind:"magic",cost:0,prize:true,armor:.4,steer:1.3,acc:1.4,top:12,brk:1.4,good:["زره ویژه: برخورد ۶۰٪ کم‌تر آسیب می‌زند","فرمان، شتاب و ترمز عالی","بالاترین سرعت","توانایی: ۳ ثانیه شبح و نیترو هم‌زمان (۹ ثانیه صبر)","پلیس کم‌کم خودش عقب می‌افتد"],bad:[]}
];
const ACT=["ghost","bolt","magic"];
let save={pts:0,own:[0],sel:0};
try{const sv=JSON.parse(localStorage.getItem("chaseSave"));if(sv&&sv.own)save=sv;}catch(e){}
save.claimed=save.claimed||[];
const ab={act:0,cd:0},cur=()=>CARS.find(c=>c.id===save.sel)||CARS[0],st=()=>Object.assign({steer:1,acc:1,top:0,brk:1,armor:1,w:.5},cur());
function persist(){try{localStorage.setItem("chaseSave",JSON.stringify(save))}catch(e){}}
function useAbility(){if(state!=="play"||ab.cd>0)return;const k=cur().kind;if(k==="ghost"){ab.act=2.5;ab.cd=14;}else if(k==="bolt"){ab.act=3;ab.cd=12;}else if(k==="magic"){ab.act=3;ab.cd=9;}}
function best(){try{return +localStorage.getItem("chaseBest")||0}catch(e){return 0}}
function saveBest(v){try{localStorage.setItem("chaseBest",v)}catch(e){}}
$("bs").textContent=best();
const stars=Array.from({length:50},()=>[Math.random()*W,Math.random()*HOR*.7,Math.random()*1.5+.3]);
const bld=[];for(let x=0;x<W;x+=26){const w=18+Math.random()*22,h=20+Math.random()*60;bld.push([x,w,h]);}
function rr(x,y,w,h,r){ctx.beginPath();if(ctx.roundRect)ctx.roundRect(x,y,w,h,r);else ctx.rect(x,y,w,h);ctx.fill();}
function sh(c,a){const n=parseInt(c.slice(1),16),f=v=>Math.round(a>0?v+(255-v)*a:v*(1+a));return"rgb("+f(n>>16)+","+f(n>>8&255)+","+f(n&255)+")";}
function poly(q,fill){ctx.fillStyle=fill;ctx.beginPath();q.forEach((a,i)=>i?ctx.lineTo(a[0],a[1]):ctx.moveTo(a[0],a[1]));ctx.closePath();ctx.fill();}
function bike(x,y,w,col,br){
  const h=w*.9,g=ctx.createLinearGradient(x-w*.2,0,x+w*.2,0);
  g.addColorStop(0,"#161d2b");g.addColorStop(.5,"#2c3a52");g.addColorStop(1,"#161d2b");
  ctx.fillStyle="rgba(0,0,0,.45)";rr(x-w*.3,y-h*.04,w*.6,h*.08,h*.04);
  ctx.fillStyle="#0a0a0a";rr(x-w*.08,y-h*.34,w*.16,h*.34,w*.05);
  ctx.fillStyle="#7d8794";rr(x+w*.12,y-h*.3,w*.06,h*.26,2);rr(x-w*.18,y-h*.3,w*.06,h*.26,2);
  ctx.fillStyle=sh(col,-.2);rr(x-w*.13,y-h*.46,w*.26,h*.18,w*.05);
  if(br){ctx.shadowBlur=12;ctx.shadowColor="#ff2020";}
  ctx.fillStyle=br?"#ff8a8a":"#ff3030";rr(x-w*.07,y-h*.44,w*.14,h*.06,2);ctx.shadowBlur=0;
  ctx.fillStyle=g;rr(x-w*.18,y-h,w*.36,h*.52,w*.09);
  ctx.fillStyle=col;rr(x-w*.18,y-h*.78,w*.36,h*.06,2);
  ctx.fillStyle="#1b2434";rr(x-w*.28,y-h*.94,w*.1,h*.3,w*.05);rr(x+w*.18,y-h*.94,w*.1,h*.3,w*.05);
  ctx.fillStyle=sh(col,.2);ctx.beginPath();ctx.arc(x,y-h*1.1,w*.14,0,7);ctx.fill();
  ctx.fillStyle=col;rr(x-w*.02,y-h*1.24,w*.04,h*.14,1);
}
function truck(x,y,w,col,br){
  const h=w*.78,g=ctx.createLinearGradient(x-w*.5,0,x+w*.5,0);
  g.addColorStop(0,sh(col,-.4));g.addColorStop(.5,sh(col,.1));g.addColorStop(1,sh(col,-.4));
  ctx.fillStyle="rgba(0,0,0,.45)";rr(x-w*.55,y-h*.05,w*1.1,h*.12,h*.06);
  ctx.fillStyle="#0a0a0a";rr(x-w*.5,y-h*.32,w*.15,h*.32,2);rr(x+w*.35,y-h*.32,w*.15,h*.32,2);
  ctx.fillStyle="#2a2d33";rr(x-w*.46,y-h*.34,w*.92,h*.12,2);
  ctx.fillStyle=g;rr(x-w*.48,y-h*1.2,w*.96,h*.88,w*.03);
  poly([[x-w*.48,y-h*1.2],[x+w*.48,y-h*1.2],[x+w*.41,y-h*1.3],[x-w*.41,y-h*1.3]],sh(col,.35));
  ctx.fillStyle=sh(col,-.55);rr(x-w*.01,y-h*1.15,w*.02,h*.78,1);rr(x-w*.42,y-h*.82,w*.84,h*.04,1);
  ctx.fillStyle="#d9d9d9";rr(x-w*.08,y-h*.75,w*.05,h*.1,1);rr(x+w*.03,y-h*.75,w*.05,h*.1,1);
  if(br){ctx.shadowBlur=14;ctx.shadowColor="#ff2020";}
  ctx.fillStyle=br?"#ff8a8a":"#ff3030";rr(x-w*.46,y-h*.5,w*.1,h*.14,2);rr(x+w*.36,y-h*.5,w*.1,h*.14,2);ctx.shadowBlur=0;
  ctx.fillStyle="#e9e9e9";rr(x-w*.1,y-h*.3,w*.2,h*.07,1);
}
function tank(x,y,w,col,br){
  const h=w*.78,g=ctx.createLinearGradient(x-w*.35,0,x+w*.35,0);
  g.addColorStop(0,sh(col,-.4));g.addColorStop(.5,sh(col,.1));g.addColorStop(1,sh(col,-.4));
  ctx.fillStyle="rgba(0,0,0,.45)";rr(x-w*.62,y-h*.05,w*1.24,h*.12,h*.06);
